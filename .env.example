# Copy to .env and fill in the REQUIRED values. Never commit .env.

# REQUIRED. Database password (letters and digits only: it goes into a URL).
POSTGRES_PASSWORD=

# REQUIRED. Signs session cookies. At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The first administrator, created on the FIRST start only (when there are no
# users). Required for that first start; changing them later has no effect.
# ADMIN_PASSWORD must be at least 8 characters.
ADMIN_EMAIL=admin@datalytics.local
ADMIN_PASSWORD=

# Optional. Host port of the web app.
FRONTEND_PORT=3002

# Optional. Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
